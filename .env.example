# Copy to .env (gitignored) and fill in real values for local development.
# Passwords appear in two places each — keep them in sync.

# ── Passwords ────────────────────────────────────────────────────────────────
# Referenced by docker-compose.yml to configure the postgres container and to
# build the connection-string overrides for the app service.

POSTGRES_PASSWORD=changeme_postgres
APP_PASSWORD=changeme_app
READONLY_PASSWORD=changeme_readonly

# ── Connection strings (local dev — dotnet run) ───────────────────────────────
# For docker-compose the host is overridden to 'db' in docker-compose.yml;
# these values are used when running the app directly on the host.

# Superuser connection — used only by DbUp at startup (EnsureDatabase + migrations).
ConnectionStrings__EveStatsMigrations=Host=localhost;Port=5432;Database=eve_stats;Username=postgres;Password=changeme_postgres

# Application connection — used by the running application after migrations.
ConnectionStrings__EveStats=Host=localhost;Port=5432;Database=eve_stats;Username=eve_stats_app;Password=changeme_app

# Read-only connection — used by the MCP server for LLM-driven queries.
ConnectionStrings__EveStatsReadonly=Host=localhost;Port=5432;Database=eve_stats;Username=eve_stats_readonly;Password=changeme_readonly

# ── DbUp variable substitution ────────────────────────────────────────────────
# Injected into migrations when creating the app and readonly roles.
# Must match APP_PASSWORD / READONLY_PASSWORD above.

DbMigrations__AppPassword=changeme_app
DbMigrations__ReadonlyPassword=changeme_readonly
