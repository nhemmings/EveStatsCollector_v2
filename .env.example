# Copy to .env (gitignored) and fill in real values for local development.

# Superuser connection string — used only by DbUp at startup (EnsureDatabase + migrations).
ConnectionStrings__EveStatsMigrations=Host=localhost;Port=5432;Database=eve_stats;Username=postgres;Password=postgres

# Application connection string — used by the running application after migrations complete.
ConnectionStrings__EveStats=Host=localhost;Port=5432;Database=eve_stats;Username=eve_stats_app;Password=changeme

# Read-only connection string — used by the MCP server for LLM-driven queries.
ConnectionStrings__EveStatsReadonly=Host=localhost;Port=5432;Database=eve_stats;Username=eve_stats_readonly;Password=changeme_readonly

# Password DbUp injects into migration 0001 when creating the eve_stats_app role.
# Must match the Password in ConnectionStrings__EveStats.
DbMigrations__AppPassword=changeme

# Password DbUp injects into migration 0002 when creating the eve_stats_readonly role.
# Must match the Password in ConnectionStrings__EveStatsReadonly.
DbMigrations__ReadonlyPassword=changeme_readonly
